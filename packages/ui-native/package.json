{
  "name": "@ruparupa/ui-native",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "description": "React Native components for the Ruparupa design system (shared contracts with @ruparupa/ui-web).",
  "files": ["dist"],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "react-native": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "react-native": "./dist/index.js",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      }
    }
  },
  "devDependencies": {
    "@repo/primitives": "workspace:*",
    "@repo/tokens": "workspace:*",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react": "10.6.1",
    "@storybook/react-native-web-vite": "10.6.1",
    "@types/react": "^19.2.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-native": "catalog:",
    "react-native-web": "catalog:",
    "storybook": "10.6.1",
    "tsup": "^8.3.0",
    "typescript": "catalog:",
    "vite": "^7.0.0"
  }
}
